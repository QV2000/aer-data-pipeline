<!doctype html>
<html lang="en">
  <body style="margin:0; padding:0; background:#f4f6f8; color:#1f2933; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%; background:#f4f6f8; margin:0; padding:24px 0;">
      <tr>
        <td align="center" style="padding:0 12px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%; max-width:600px; background:#ffffff; border:1px solid #d9e2ec; border-radius:8px; overflow:hidden;">
            <tr>
              <td style="padding:24px 24px 18px 24px; border-bottom:1px solid #e5eaf0;">
                <h1 style="margin:0 0 8px 0; font-size:24px; line-height:30px; color:#17212b; font-weight:700;">This week in the patch</h1>
                <div style="font-size:14px; line-height:21px; color:#52606d;">{{ counts.new_operator }} new operators &middot; {{ counts.near_facility }} operators with new activity within 100km &middot; {{ counts.production_mover }} production movers</div>
              </td>
            </tr>

            {% if sections.new_operator %}
            <tr>
              <td style="padding:22px 24px 4px 24px;">
                <h2 style="margin:0; font-size:17px; line-height:24px; color:#17212b;">New operators on the radar</h2>
              </td>
            </tr>
            {% for operator in sections.new_operator %}
            <tr>
              <td style="padding:10px 24px 14px 24px;">
                {% include "_weekly_digest_card.html.j2" %}
              </td>
            </tr>
            {% endfor %}
            {% endif %}

            {% if sections.near_facility %}
            <tr>
              <td style="padding:22px 24px 4px 24px;">
                <h2 style="margin:0; font-size:17px; line-height:24px; color:#17212b;">Existing operators, new activity within 100km</h2>
              </td>
            </tr>
            {% for operator in sections.near_facility %}
            <tr>
              <td style="padding:10px 24px 14px 24px;">
                {% include "_weekly_digest_card.html.j2" %}
              </td>
            </tr>
            {% endfor %}
            {% endif %}

            {% if sections.production_mover %}
            <tr>
              <td style="padding:22px 24px 4px 24px;">
                <h2 style="margin:0; font-size:17px; line-height:24px; color:#17212b;">Production movers</h2>
              </td>
            </tr>
            {% for operator in sections.production_mover %}
            <tr>
              <td style="padding:10px 24px 14px 24px;">
                {% include "_weekly_digest_card.html.j2" %}
              </td>
            </tr>
            {% endfor %}
            {% endif %}

            {% if not has_activity %}
            <tr>
              <td style="padding:28px 24px; font-size:14px; line-height:21px; color:#52606d;">No new crude operator activity matched the digest filters for this period.</td>
            </tr>
            {% endif %}

            <tr>
              <td style="padding:22px 24px 24px 24px; border-top:1px solid #e5eaf0;">
                <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%;">
                  <tr>
                    <td style="font-size:13px; line-height:20px; color:#52606d;">Generated for week of {{ week_label }}.</td>
                    <td align="right" style="font-size:13px; line-height:20px;">
                      <a href="{{ full_list_url }}" style="color:#0b5cad; text-decoration:none; font-weight:700;">Open full list ↗</a>
                      <span style="color:#9fb3c8;">&nbsp;|&nbsp;</span>
                      <a href="{{ xlsx_url }}" style="color:#0b5cad; text-decoration:none; font-weight:700;">Download xlsx</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
