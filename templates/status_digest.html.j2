<!doctype html>
<html lang="en">
  <body style="margin:0; padding:0; background:#f4f6f8; color:#1f2933; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%; background:#f4f6f8; margin:0; padding:24px 0;">
      <tr>
        <td align="center" style="padding:0 12px;">
          <table role="presentation" width="680" cellspacing="0" cellpadding="0" style="width:100%; max-width:680px; background:#ffffff; border:1px solid #d9e2ec; border-radius:8px; overflow:hidden;">
            <tr>
              <td style="padding:24px 24px 18px 24px; border-bottom:1px solid #e5eaf0;">
                <h1 style="margin:0 0 8px 0; font-size:24px; line-height:30px; color:#17212b; font-weight:700;">Well status changes
                  {%- if days == 7 %} — last week
                  {%- elif days == 28 %} — last 4 weeks
                  {%- else %} — last {{ days }} days
                  {%- endif %}
                </h1>
                <div style="font-size:14px; line-height:21px; color:#52606d;">
                  {{ total_wells }} wells across {{ operator_count }} operators &middot;
                  within {{ max_km|int }} km of any TEMI facility &middot;
                  window {{ window_start|date_label }} to {{ anchor_date|date_label }}
                </div>
                {% if pattern_counts %}
                <div style="margin-top:10px; font-size:13px; line-height:19px; color:#243b53;">
                  {% for label, count in pattern_counts.items() %}
                    {{ count }} × {{ label }}{% if not loop.last %} &middot; {% endif %}
                  {% endfor %}
                </div>
                {% endif %}
              </td>
            </tr>

            {% if operators %}
            {% for op in operators %}
            <tr>
              <td style="padding:14px 24px 16px 24px; border-top:1px solid #eef2f7;">
                <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%;">
                  <tr>
                    <td style="vertical-align:top;">
                      <div style="font-size:16px; line-height:22px; color:#17212b; font-weight:700;">{{ op.operator_name }}</div>
                      <div style="font-size:13px; line-height:19px; color:#52606d; margin-top:2px;">
                        {%- if op.provinces -%}{{ op.provinces }}{%- endif -%}
                        {%- if op.licensee_code -%} &middot; <span style="font-family:Consolas, Menlo, monospace;">{{ op.licensee_code }}</span>{%- endif -%}
                      </div>
                    </td>
                    <td align="right" style="vertical-align:top; font-size:12px; line-height:18px; color:#0b5cad; font-weight:700; white-space:nowrap;">
                      {{ op.well_count }} {% if op.well_count == 1 %}well{% else %}wells{% endif %}
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%; margin-top:10px;">
                  {% for well in op.wells %}
                  <tr>
                    <td style="vertical-align:top; padding:3px 0; font-size:13px; line-height:19px; color:#243b53;">
                      <span style="color:#9fb3c8;">•</span>
                      <span style="font-weight:700;">{{ well.pattern_label }}</span>
                      <span style="color:#52606d;">&nbsp;·&nbsp;</span>
                      <span style="font-family:Consolas, Menlo, monospace;">{{ well.lsd or well.uwi }}</span>
                      <span style="color:#52606d;">&nbsp;·&nbsp;{{ well.event_date|date_label }}</span>
                      {% if well.distance_km is not none and well.nearest_facility_name %}
                      <span style="color:#52606d;">&nbsp;·&nbsp;{{ well.distance_km }} km from {{ well.nearest_facility_name }}</span>
                      {% endif %}
                      {% if well.well_name and well.well_name != well.lsd %}
                      <div style="margin-left:14px; font-size:12px; color:#7e8a99;">{{ well.well_name }}</div>
                      {% endif %}
                    </td>
                  </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td style="padding:28px 24px; font-size:14px; line-height:21px; color:#52606d;">No status transitions in this window.</td>
            </tr>
            {% endif %}

            <tr>
              <td style="padding:18px 24px 22px 24px; border-top:1px solid #e5eaf0; font-size:12px; line-height:18px; color:#7e8a99;">
                Source: AER ST2 (status_changes). Transitions tracked:
                Drilled &amp; complete → pumping crude oil ·
                Drilled &amp; complete → pumping bitumen ·
                Drilled &amp; complete → flowing crude oil ·
                Suspended → pumping crude oil.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
